<Window x:Class="PlatzAtlas.Player.PlayerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:room="clr-namespace:PlatzAtlas.RoomView;assembly=PlatzAtlas.RoomView"
        Title="PLATZ Player" Width="1120" Height="720" MinWidth="625" MinHeight="460" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" PreviewKeyDown="PlayerKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="60"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <DockPanel Margin="18,0">
        <TextBlock DockPanel.Dock="Left" Text="PLATZ PLAYER" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,22,0"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="OpenRoomButton" Content="Open room…" Click="OpenClicked" Margin="0,0,6,0"/>
          <Button x:Name="RestartButton" Content="Restart room" Click="RestartClicked" IsEnabled="False"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="18,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="220"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,12,12">
        <TextBlock x:Name="RoomTitle" Text="Open a room package" FontWeight="SemiBold" FontSize="26" TextWrapping="Wrap"/>
        <TextBlock x:Name="SourceLabel" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
      </StackPanel>
      <Border Grid.Row="1" Background="#101A20" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,12,0">
        <room:RoomViewport x:Name="Viewport" AutomationProperties.Name="Playable museum room"/>
      </Border>
      <Border x:Name="Controls" Grid.Row="1" Grid.Column="1" IsEnabled="False"
              Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Move" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
            <UniformGrid Columns="4" Margin="0,7,0,0">
              <Button Content="←" Tag="Left" Click="MoveClicked" Margin="0,0,4,0" Padding="3" AutomationProperties.Name="Walk left"/>
              <Button Content="↑" Tag="Up" Click="MoveClicked" Margin="0,0,4,0" Padding="3" AutomationProperties.Name="Walk up"/>
              <Button Content="↓" Tag="Down" Click="MoveClicked" Margin="0,0,4,0" Padding="3" AutomationProperties.Name="Walk down"/>
              <Button Content="→" Tag="Right" Click="MoveClicked" Padding="3" AutomationProperties.Name="Walk right"/>
            </UniformGrid>
            <TextBlock Text="Arrow keys or WASD" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
            <TextBlock x:Name="ProgressLabel" Visibility="Collapsed" Foreground="{StaticResource Accent}"
                       TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,13,0,0" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="NearbyLabel" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
            <Button x:Name="UseButton" Content="Use nearby switch (E)" Click="UseClicked" Margin="0,7,0,0"
                    BorderBrush="{StaticResource Accent}" FontSize="13"/>
            <TextBlock x:Name="ActionLabel" TextWrapping="Wrap" Margin="0,13,0,0" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="LightLabel" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18,8">
      <DockPanel>
        <TextBlock x:Name="BackendLabel" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
        <TextBlock x:Name="StatusLabel" Text="Choose a .platzroom file exported by Studio." Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
