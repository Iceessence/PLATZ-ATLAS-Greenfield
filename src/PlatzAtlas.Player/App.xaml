<Application x:Class="PlatzAtlas.Player.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Page" Color="#11191C"/>
    <SolidColorBrush x:Key="Panel" Color="#172124"/>
    <SolidColorBrush x:Key="Surface" Color="#202D30"/>
    <SolidColorBrush x:Key="Border" Color="#354548"/>
    <SolidColorBrush x:Key="Text" Color="#EFF4F2"/>
    <SolidColorBrush x:Key="Muted" Color="#A7B9B8"/>
    <SolidColorBrush x:Key="Accent" Color="#A9D5FF"/>
    <SolidColorBrush x:Key="Error" Color="#FFAD99"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonFace" CornerRadius="5" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="ButtonFace" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonFace" Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
