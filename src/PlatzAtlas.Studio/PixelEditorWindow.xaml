<Window x:Class="PlatzAtlas.Studio.PixelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLATZ Pixel Editor" Width="960" Height="710" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Page}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" UseLayoutRounding="True" PreviewKeyDown="EditorKeyDown">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Pixel editor" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock x:Name="SourceNote" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="−" Tag="out" Style="{StaticResource ToolbarButton}" Click="PixelZoomClicked" Margin="0,0,4,0" AutomationProperties.Name="Zoom out"/>
        <Button Content="Fit" Tag="fit" Style="{StaticResource ToolbarButton}" Click="PixelZoomClicked" Margin="0,0,4,0"/>
        <Button Content="+" Tag="in" Style="{StaticResource ToolbarButton}" Click="PixelZoomClicked" Margin="0,0,12,0" AutomationProperties.Name="Zoom in"/>
        <Button x:Name="PixelUndo" Content="Undo pixels" Style="{StaticResource ToolbarButton}" Click="UndoClicked" Margin="0,0,6,0"/>
        <Button x:Name="PixelRedo" Content="Redo" Style="{StaticResource ToolbarButton}" Click="RedoClicked"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="272"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="7" Background="#0A1014" Margin="0,0,14,0">
        <ScrollViewer x:Name="PixelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      PanningMode="Both" PreviewMouseWheel="PixelZoomWheel" PreviewMouseDown="PixelPanDown"
                      PreviewMouseMove="PixelPanMove" PreviewMouseUp="PixelPanUp">
        <Viewbox x:Name="CanvasBox" Stretch="Uniform" Margin="12" Width="384" Height="384"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
          <Grid x:Name="PixelSurface" Width="384" Height="384" Focusable="True" Cursor="Cross"
                MouseLeftButtonDown="PixelDown" MouseMove="PixelMove" MouseLeftButtonUp="PixelUp"
                LostMouseCapture="PixelCaptureLost" AutomationProperties.Name="Pixel canvas, arrow keys and Space">
            <Grid.Background>
              <DrawingBrush Viewport="0,0,24,24" ViewportUnits="Absolute" TileMode="Tile">
                <DrawingBrush.Drawing>
                  <DrawingGroup>
                    <GeometryDrawing Brush="#2B363C" Geometry="M0,0 H24 V24 H0 Z"/>
                    <GeometryDrawing Brush="#3E4B53" Geometry="M0,0 H12 V12 H0 Z M12,12 H24 V24 H12 Z"/>
                  </DrawingGroup>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Grid.Background>
            <Image x:Name="OnionSkinImage" Stretch="Fill" Opacity="0.28" IsHitTestVisible="False" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            <Image x:Name="PixelImage" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            <Canvas x:Name="CursorLayer" IsHitTestVisible="False">
              <Border x:Name="PixelCursor" BorderBrush="#FFFFFF" BorderThickness="1.5" Visibility="Collapsed"/>
            </Canvas>
          </Grid>
        </Viewbox>
        </ScrollViewer>
      </Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
        <StackPanel>
          <Border Style="{StaticResource SectionCard}" Padding="10">
            <StackPanel>
              <TextBlock Text="Canvas size" Style="{StaticResource Caption}"/>
              <UniformGrid x:Name="CanvasSizes" Columns="3" Margin="0,6,0,6">
                <Button x:Name="Pixels16" Content="16 × 16" Tag="16" Style="{StaticResource ToolbarButton}" Click="SizeClicked" Margin="0,0,4,4" Padding="4"/>
                <Button x:Name="Pixels32" Content="32 × 32" Tag="32" Style="{StaticResource ToolbarButton}" Click="SizeClicked" Margin="0,0,4,4" Padding="4"/>
                <Button x:Name="Pixels64" Content="64" Tag="64" Style="{StaticResource ToolbarButton}" Click="SizeClicked" Margin="0,0,0,4" Padding="4" AutomationProperties.Name="64 by 64"/>
                <Button Content="128" Tag="128" Style="{StaticResource ToolbarButton}" Click="SizeClicked" Margin="0,0,4,0" Padding="4" AutomationProperties.Name="128 by 128"/>
                <Button Content="256" Tag="256" Style="{StaticResource ToolbarButton}" Click="SizeClicked" Padding="4" AutomationProperties.Name="256 by 256"/>
              </UniformGrid>
              <TextBlock x:Name="CanvasSizeNote" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SectionCard}" Padding="10">
            <StackPanel>
              <TextBlock Text="Tools" Style="{StaticResource Caption}"/>
              <UniformGrid Columns="3" Margin="0,6,0,0" x:Name="ToolButtons">
                <Button x:Name="ToolPaint" Content="Paint" Tag="Paint" Style="{StaticResource ToolbarButton}" Click="ToolClicked" Margin="0,0,4,4" Padding="4"/>
                <Button Content="Erase" Tag="Erase" Style="{StaticResource ToolbarButton}" Click="ToolClicked" Margin="0,0,4,4" Padding="4"/>
                <Button Content="Fill" Tag="Fill" Style="{StaticResource ToolbarButton}" Click="ToolClicked" Margin="0,0,0,4" Padding="4"/>
                <Button x:Name="ToolLine" Content="Line" Tag="Line" Style="{StaticResource ToolbarButton}" Click="ToolClicked" Margin="0,0,4,0" Padding="4"/>
                <Button x:Name="ToolRect" Content="Rect" Tag="Rect" Style="{StaticResource ToolbarButton}" Click="ToolClicked" Margin="0,0,4,0" Padding="4"/>
                <Button Content="Picker" Tag="Eyedropper" Style="{StaticResource ToolbarButton}" Click="ToolClicked" Padding="4" AutomationProperties.Name="Eyedropper"/>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SectionCard}" Padding="10">
            <StackPanel>
              <TextBlock Text="Palette &amp; RGBA" Style="{StaticResource Caption}"/>
              <UniformGrid x:Name="Palette" Columns="6" Margin="0,6,0,10"/>
              <DockPanel Margin="0,0,0,8">
                <Border x:Name="ColorPreviewSwatch" Width="32" Height="32" CornerRadius="5" Margin="0,0,8,0"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" DockPanel.Dock="Left"/>
                <TextBox x:Name="PixelColor" MaxLength="9" AutomationProperties.Name="Pixel color as RRGGBBAA"
                         FontFamily="Consolas" TextChanged="PixelColorChanged"/>
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="R" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <Slider x:Name="SliderR" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Margin="4,2" ValueChanged="RgbaSliderChanged" AutomationProperties.Name="Red channel"/>
                <TextBlock x:Name="LabelR" Grid.Column="2" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="G" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <Slider x:Name="SliderG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Margin="4,2" ValueChanged="RgbaSliderChanged" AutomationProperties.Name="Green channel"/>
                <TextBlock x:Name="LabelG" Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="B" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <Slider x:Name="SliderB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Margin="4,2" ValueChanged="RgbaSliderChanged" AutomationProperties.Name="Blue channel"/>
                <TextBlock x:Name="LabelB" Grid.Row="2" Grid.Column="2" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Text="A" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <Slider x:Name="SliderA" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" Margin="4,2" ValueChanged="RgbaSliderChanged" AutomationProperties.Name="Alpha channel"/>
                <TextBlock x:Name="LabelA" Grid.Row="3" Grid.Column="2" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SectionCard}" Margin="0" Padding="10">
            <StackPanel>
              <TextBlock Text="Asset name" Style="{StaticResource Caption}"/>
              <TextBox x:Name="AssetName" MaxLength="160" AutomationProperties.Name="Sprite asset name" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,10,0,0" Padding="10">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <Button x:Name="TimelinePlay" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="Play frames" Click="TimelinePlayClicked" Margin="6,0,0,0"/>
          <CheckBox x:Name="OnionSkinToggle" DockPanel.Dock="Right" Content="Onion skin" Margin="10,0,4,0" Checked="OnionSkinChanged" Unchecked="OnionSkinChanged"/>
          <TextBlock x:Name="TimelineSummary" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,4,0"/>
          <TextBlock Text="Frames" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0" DockPanel.Dock="Left"/>
          <ComboBox x:Name="TimelineFrames" SelectionChanged="FrameSelected" AutomationProperties.Name="Animation frame"/>
        </DockPanel>
        <WrapPanel>
          <Button x:Name="AddFrame" Content="Add blank" Style="{StaticResource ToolbarButton}" Tag="blank" Click="TimelineEdited" Margin="0,0,4,3"/>
          <Button x:Name="DuplicateFrame" Content="Duplicate" Style="{StaticResource ToolbarButton}" Tag="duplicate" Click="TimelineEdited" Margin="0,0,4,3"/>
          <Button x:Name="DeleteFrame" Content="Delete frame" Style="{StaticResource ToolbarButton}" Tag="delete" Click="TimelineEdited" Margin="0,0,4,3"/>
          <Button x:Name="FrameEarlier" Content="←" Style="{StaticResource ToolbarButton}" Tag="earlier" Click="TimelineEdited" Margin="0,0,4,3" AutomationProperties.Name="Move frame earlier"/>
          <Button x:Name="FrameLater" Content="→" Style="{StaticResource ToolbarButton}" Tag="later" Click="TimelineEdited" Margin="0,0,9,3" AutomationProperties.Name="Move frame later"/>
          <TextBlock Text="Frame ms" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,3"/>
          <TextBox x:Name="FrameDuration" Width="54" MaxLength="4" Margin="0,0,4,3" AutomationProperties.Name="Frame duration in milliseconds"/>
          <Button x:Name="SetDuration" Content="Set" Style="{StaticResource ToolbarButton}" Tag="duration" Click="TimelineEdited" Margin="0,0,0,3"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <TextBlock x:Name="PixelStatus" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ExportSpriteSheet" Content="Export sheet…" Style="{StaticResource ToolbarButton}" Click="ExportSheetClicked" Margin="6,0,0,0"/>
        <Button x:Name="ExportSpritePng" Content="Export PNG…" Style="{StaticResource ToolbarButton}" Click="ExportClicked" Margin="6,0,6,0"/>
        <Button x:Name="KeepSprite" Content="Add to assets" Style="{StaticResource PrimaryButton}" Click="KeepClicked" Margin="0,0,6,0"/>
        <Button Content="Close" Style="{StaticResource ToolbarButton}" IsCancel="True"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
