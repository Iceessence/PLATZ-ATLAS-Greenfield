<Window x:Class="PlatzAtlas.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PlatzAtlas.Studio"
        xmlns:room="clr-namespace:PlatzAtlas.RoomView;assembly=PlatzAtlas.RoomView"
        Title="PLATZ ATLAS Studio" Width="1340" Height="820" MinWidth="770" MinHeight="555"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" PreviewKeyDown="StudioPlayKeyDown">
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.New" Executed="NewExecuted" CanExecute="CanAuthor"/>
    <CommandBinding Command="ApplicationCommands.Open" Executed="OpenExecuted" CanExecute="CanAuthor"/>
    <CommandBinding Command="ApplicationCommands.Save" Executed="SaveExecuted" CanExecute="CanAuthor"/>
    <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAsExecuted" CanExecute="CanAuthor"/>
    <CommandBinding Command="ApplicationCommands.Undo" Executed="UndoExecuted" CanExecute="CanUndo"/>
    <CommandBinding Command="ApplicationCommands.Redo" Executed="RedoExecuted" CanExecute="CanRedo"/>
    <CommandBinding Command="{x:Static local:MainWindow.TogglePlayCommand}" Executed="TogglePlayExecuted" CanExecute="CanTogglePlay"/>
    <CommandBinding Command="{x:Static local:MainWindow.ExportRoomCommand}" Executed="ExportRoomExecuted" CanExecute="CanExportRoom"/>
  </Window.CommandBindings>
  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="ApplicationCommands.SaveAs"/>
    <KeyBinding Key="Z" Modifiers="Control+Shift" Command="ApplicationCommands.Redo"/>
    <KeyBinding Key="F5" Command="{x:Static local:MainWindow.TogglePlayCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
      <DockPanel Margin="19,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0">
          <Border Width="32" Height="32" CornerRadius="7" Background="{StaticResource Accent}" Margin="0,0,10,0">
            <Path Width="17" Height="17" Stretch="Uniform" Fill="#221B16"
                  Data="M 8,0 L 16,8 L 8,16 L 0,8 Z M 8,4 L 4,8 L 8,12 L 12,8 Z"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PLATZ ATLAS" FontWeight="Bold" FontSize="15"/>
            <TextBlock Text="Studio" Foreground="{StaticResource Muted}" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="NewBlank" Content="_Blank project" Click="NewBlankClicked" Margin="0,0,6,0"/>
          <Button Content="_New museum" Command="ApplicationCommands.New" Margin="0,0,6,0" ToolTip="New museum (Ctrl+N)" />
          <Button Content="_Open…" Command="ApplicationCommands.Open" Margin="0,0,6,0" ToolTip="Open a local project (Ctrl+O)"/>
          <Button Content="_Save" Command="ApplicationCommands.Save" Margin="0,0,6,0" ToolTip="Save the project (Ctrl+S)"/>
          <Button Content="Save _as…" Command="ApplicationCommands.SaveAs" ToolTip="Save a local copy (Ctrl+Shift+S)"/>
          <Border Width="1" Margin="12,3" Background="{StaticResource Border}"/>
          <Button Content="_Undo" Command="ApplicationCommands.Undo" Margin="0,0,6,0" ToolTip="Undo (Ctrl+Z)"/>
          <Button Content="_Redo" Command="ApplicationCommands.Redo" ToolTip="Redo (Ctrl+Y)"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="174"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="258"/>
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
        <DockPanel Margin="13,21,13,12">
          <StackPanel DockPanel.Dock="Top" Margin="3,0,0,13">
            <TextBlock Text="Scene" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="ObjectCount" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
          </StackPanel>
          <WrapPanel x:Name="SceneActions" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,10">
            <Button x:Name="AddWall" Content="+ Wall" Tag="Wall" Click="AddSceneClicked" Margin="0,0,4,4" Padding="6,4"/>
            <Button x:Name="AddLamp" Content="+ Lamp" Tag="Lamp" Click="AddSceneClicked" Margin="0,0,4,4" Padding="6,4"/>
            <Button x:Name="AddDoor" Content="+ Door" Tag="Door" Click="AddSceneClicked" Margin="0,0,4,4" Padding="6,4"/>
            <Button x:Name="AddSwitch" Content="+ Switch" Tag="Switch" Click="AddSceneClicked" Margin="0,0,4,4" Padding="6,4"/>
            <Button x:Name="AddSpawn" Content="+ Spawn" Tag="Spawn" Click="AddSceneClicked" Margin="0,0,4,4" Padding="6,4"/>
            <Button x:Name="AddKey" Content="+ Key" Tag="Key" Click="AddSceneClicked" Margin="0,0,4,4" Padding="6,4"/>
            <Button x:Name="AddGoal" Content="+ Goal" Tag="Goal" Click="AddSceneClicked" Margin="0,0,4,4" Padding="6,4"/>
          </WrapPanel>
          <ListBox x:Name="Objects" SelectionChanged="SelectionChanged" Background="Transparent" BorderThickness="0"
                   AutomationProperties.Name="Scene objects" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Template>
              <ControlTemplate TargetType="ListBox">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                  <ScrollViewer Focusable="False" Background="Transparent"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Path Width="12" Height="16" Margin="0,3,9,0" VerticalAlignment="Top"
                        Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.2"
                        Data="M 2,4 L 10,4 L 11,13 L 1,13 Z M 4,4 L 4,1 L 8,1 L 8,4 M 6,7 L 6,10"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip="{Binding Name}"
                               TextTrimming="CharacterEllipsis" MaxWidth="115"/>
                    <TextBlock Text="{Binding Location}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="19,18,19,17">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="1,0,0,14">
          <DockPanel>
            <Button x:Name="PlayToggle" DockPanel.Dock="Right" Command="{x:Static local:MainWindow.TogglePlayCommand}"
                    Content="Play" Margin="8,0,0,0" Padding="13,5" MinHeight="32" VerticalAlignment="Center"
                    BorderBrush="{StaticResource PlayAccent}" ToolTipService.ShowOnDisabled="True"/>
            <TextBlock x:Name="RoomTitle" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <DockPanel Margin="0,3,0,0">
            <Button x:Name="ExportRoomButton" DockPanel.Dock="Right" Content="Export room…"
                    Command="{x:Static local:MainWindow.ExportRoomCommand}" Padding="7,3" MinHeight="25"
                    Margin="8,0,0,0" ToolTip="Save a room package from the current saved revision."
                    ToolTipService.ShowOnDisabled="True"/>
            <TextBlock x:Name="RevisionLabel" Foreground="{StaticResource Muted}" FontSize="13"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="BlankRoomHelp" Visibility="Collapsed" Margin="0,9,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource Muted}"
                     Text="Add an object from the Scene panel, or import an image from Assets. Try New museum for a ready-made room."/>
          <Border x:Name="PlayBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="10,8"
                  Background="{StaticResource PlaySurface}" BorderBrush="{StaticResource PlayAccent}"
                  BorderThickness="1" CornerRadius="5">
            <TextBlock x:Name="PlayBannerText" Foreground="{StaticResource PlayAccent}" FontWeight="SemiBold"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          </Border>
          <Border x:Name="AtlasPreviewBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="9,6"
                  Background="{StaticResource PreviewSurface}" BorderBrush="{StaticResource PreviewAccent}"
                  BorderThickness="1" CornerRadius="5">
            <StackPanel>
              <DockPanel>
                <Button x:Name="AtlasPreviewExit" DockPanel.Dock="Right" Content="Exit preview"
                        Click="AtlasPreviewExitClicked" Margin="9,0,0,0" Padding="7,4" MinHeight="30"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="AtlasPreviewLabel" Foreground="{StaticResource PreviewAccent}"
                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
              </DockPanel>
              <Border x:Name="AtlasCommitConfirmation" Visibility="Collapsed" Margin="0,7,0,1" Padding="0,7,0,0"
                      BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <StackPanel>
                  <TextBlock x:Name="AtlasCommitSummary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                  <WrapPanel Margin="0,7,0,1">
                    <Button x:Name="AtlasCommitCancel" Content="Cancel review" Click="AtlasCommitCancelClicked"
                            Margin="0,0,7,0" MinHeight="32" Padding="8,5"/>
                    <Button x:Name="AtlasCommitConfirm" Click="AtlasCommitConfirmClicked" Style="{StaticResource PrimaryButton}"
                            MinHeight="32" Padding="8,5" AutomationProperties.Name="Confirm and save ATLAS light change">
                      <TextBlock Text="Confirm and save" Foreground="#221B16"/>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border x:Name="SceneAtlasPreviewBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="9,7"
                  Background="{StaticResource PreviewSurface}" BorderBrush="{StaticResource PreviewAccent}"
                  BorderThickness="1" CornerRadius="5">
            <StackPanel>
              <TextBlock x:Name="SceneAtlasDraftText" TextWrapping="Wrap" Foreground="{StaticResource PreviewAccent}"
                         AutomationProperties.LiveSetting="Polite"/>
              <WrapPanel Margin="0,6,0,0">
                <Button x:Name="SceneAtlasCancel" Content="Cancel preview" Click="SceneAtlasCancelClicked" Margin="0,0,6,0"/>
                <Button x:Name="SceneAtlasConfirm" Content="Confirm and save" Click="SceneAtlasConfirmClicked"
                        Style="{StaticResource PrimaryButton}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="1"
                Background="#101A20">
          <room:RoomViewport x:Name="Viewport" AutomationProperties.Name="Museum room preview"/>
        </Border>
        <Grid Grid.Row="2" Margin="0,9,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="WestCard" BorderBrush="{StaticResource Border}" BorderThickness="1"
                  Background="{StaticResource Panel}" CornerRadius="5" Padding="10,8">
            <StackPanel>
              <TextBlock x:Name="WestLabel" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="WestState" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="EastCard" Grid.Column="2" BorderBrush="{StaticResource Border}" BorderThickness="1"
                  Background="{StaticResource Panel}" CornerRadius="5" Padding="10,8">
            <StackPanel>
              <TextBlock x:Name="EastLabel" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="EastState" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
        <Grid>
        <TabControl x:Name="SideTabs" BorderThickness="0" AutomationProperties.Name="Workspace panels">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <DockPanel KeyboardNavigation.TabNavigation="Local">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                  <TabPanel IsItemsHost="True" Margin="11,6,11,0" KeyboardNavigation.TabIndex="0"/>
                </Border>
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                  KeyboardNavigation.TabIndex="1"/>
              </DockPanel>
            </ControlTemplate>
          </TabControl.Template>
          <TabControl.ItemContainerStyle>
            <Style TargetType="TabItem">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabFace" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="0,0,0,2" Padding="12,9" Margin="0,0,3,0">
                      <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="TabFace" Property="Background" Value="{StaticResource Surface}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="TabFace" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        <Setter TargetName="TabFace" Property="Background" Value="{StaticResource Selection}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="TabFace" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        <Setter TargetName="TabFace" Property="BorderThickness" Value="1,1,1,2"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </TabControl.ItemContainerStyle>
          <TabItem x:Name="InspectorTab" Header="Inspector">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="15,21,15,14">
            <TextBlock x:Name="SelectedName" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SelectedLocation" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            <Border x:Name="MuseumInspector" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="6" Margin="0,20,0,0" Padding="11">
              <StackPanel>
                <TextBlock x:Name="SwitchHeading" FontWeight="SemiBold"/>
                <TextBlock x:Name="SwitchTarget" Foreground="{StaticResource Muted}" FontSize="12"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                <Button x:Name="ToggleLight" Click="ToggleLightClicked" Margin="0,12,0,0"
                        Style="{StaticResource PrimaryButton}">
                  <TextBlock x:Name="ToggleLabel" Foreground="#221B16"/>
                </Button>
                <StackPanel x:Name="SwitchBehaviorEditor" Margin="0,13,0,0">
                  <TextBlock Text="Switch behavior in Play" Style="{StaticResource Caption}"/>
                  <UniformGrid Columns="2" Margin="0,5,0,0">
                    <Button x:Name="SwitchModeToggle" Content="Toggle" Tag="Toggle" Click="SwitchModeClicked"
                            Padding="5,5" MinHeight="30" Margin="0,0,5,0" ToolTip="Alternate between on and off."/>
                    <Button x:Name="SwitchModeTurnOn" Content="Turn on" Tag="TurnOn" Click="SwitchModeClicked"
                            Padding="5,5" MinHeight="30" ToolTip="Set the light on each time the switch is used."/>
                  </UniformGrid>
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel x:Name="SceneInspector" Visibility="Collapsed" Margin="0,15,0,0">
              <StackPanel.Resources>
                <Style TargetType="TextBox">
                  <Setter Property="Background" Value="{StaticResource Page}"/>
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                  <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                  <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
                  <Setter Property="Padding" Value="5,4"/>
                  <Setter Property="Margin" Value="2"/>
                  <Setter Property="IsUndoEnabled" Value="False"/>
                </Style>
              </StackPanel.Resources>
              <TextBlock Text="Name" Style="{StaticResource Caption}"/>
              <TextBox x:Name="SceneName" AutomationProperties.Name="Object name" MaxLength="96"/>
              <Button x:Name="RenameObject" Content="Rename" Click="RenameSceneClicked" Margin="2,5,2,10"/>
              <TextBlock Text="Transform" Style="{StaticResource Caption}"/>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="X" Style="{StaticResource Caption}"/>
                  <TextBox x:Name="SceneX" AutomationProperties.Name="Position X"/>
                  <TextBlock Text="Width" Style="{StaticResource Caption}"/>
                  <TextBox x:Name="SceneWidth" AutomationProperties.Name="Width"/>
                  <TextBlock Text="Rotation °" Style="{StaticResource Caption}"/>
                  <TextBox x:Name="SceneRotation" AutomationProperties.Name="Rotation in degrees"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Y" Style="{StaticResource Caption}"/>
                  <TextBox x:Name="SceneY" AutomationProperties.Name="Position Y"/>
                  <TextBlock Text="Height" Style="{StaticResource Caption}"/>
                  <TextBox x:Name="SceneHeight" AutomationProperties.Name="Height"/>
                </StackPanel>
              </Grid>
              <Button x:Name="ApplyTransform" Content="Apply transform" Click="ApplyTransformClicked" Margin="2,5,2,10"/>
              <Button x:Name="ChangeColor" Content="Change wall color" Click="ChangeSceneColorClicked" Margin="2,2"/>
              <Button x:Name="ChangeLight" Click="ChangeSceneLampClicked" Margin="2,2"/>
              <Button x:Name="ChangeDoor" Click="ChangeSceneDoorClicked" Margin="2,2"/>
              <StackPanel x:Name="SceneSwitchEditor" Visibility="Collapsed" Margin="2,7">
                <TextBlock Text="Switch target" Style="{StaticResource Caption}"/>
                <ComboBox x:Name="SwitchEntityTarget" AutomationProperties.Name="Switch target" DisplayMemberPath="Label"
                          Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                          Margin="0,4,0,8" TextSearch.TextPath="Label"/>
                <TextBlock Text="Second target (optional)" Style="{StaticResource Caption}"/>
                <ComboBox x:Name="SwitchSecondTarget" AutomationProperties.Name="Second switch target" DisplayMemberPath="Label"
                          Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                          Margin="0,4,0,8" TextSearch.TextPath="Label"/>
                <TextBlock Text="Switch behavior" Style="{StaticResource Caption}"/>
                <ComboBox x:Name="SwitchEntityMode" AutomationProperties.Name="Switch behavior" Margin="0,4,0,4"
                          Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" SelectedValuePath="Tag">
                  <ComboBoxItem Content="Toggle" Tag="Toggle"/>
                  <ComboBoxItem Content="Turn on / Open" Tag="TurnOn"/>
                </ComboBox>
                <Button x:Name="ApplySwitchLink" Content="Apply switch link" Click="ConfigureSceneSwitchClicked"/>
              </StackPanel>
              <StackPanel x:Name="GoalEditor" Visibility="Collapsed" Margin="2,7">
                <TextBlock Text="Keys required to win" Style="{StaticResource Caption}"/>
                <TextBox x:Name="RequiredKeys" AutomationProperties.Name="Keys required to win" MaxLength="2"/>
                <Button x:Name="ApplyGoal" Content="Apply goal rule" Click="ApplyGoalClicked"/>
              </StackPanel>
              <Button x:Name="DeleteObject" Content="Delete object" Click="DeleteSceneClicked" Margin="2,9,2,0"/>
            </StackPanel>
            <TextBlock Text="Object ID" Style="{StaticResource Caption}" Margin="0,22,0,4"/>
            <TextBlock x:Name="ObjectId" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="Project ID" Style="{StaticResource Caption}" Margin="0,15,0,4"/>
            <TextBlock x:Name="ProjectId" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="Renderer" Style="{StaticResource Caption}" Margin="0,15,0,6"/>
            <UniformGrid Columns="2">
              <Button x:Name="RendererAuto" Content="Auto" Tag="Auto" Click="RendererClicked" Margin="0,0,4,4"
                      Padding="6,5" MinHeight="30" FontSize="12" AutomationProperties.Name="Renderer: Auto"
                      ToolTip="Prefer Vulkan with OpenGL and CPU Reference fallback"/>
              <Button x:Name="RendererVulkan" Content="Vulkan" Tag="Vulkan" Click="RendererClicked" Margin="0,0,0,4"
                      Padding="6,5" MinHeight="30" FontSize="12" AutomationProperties.Name="Renderer: Vulkan"
                      ToolTip="Use Vulkan GPU renderer"/>
              <Button x:Name="RendererOpenGl" Content="OpenGL" Tag="OpenGl" Click="RendererClicked" Margin="0,0,4,0"
                      Padding="6,5" MinHeight="30" FontSize="12" AutomationProperties.Name="Renderer: OpenGL"
                      ToolTip="Use OpenGL compatibility renderer"/>
              <Button x:Name="RendererCpu" Content="CPU" Tag="CpuReference" Click="RendererClicked" Margin="0"
                      Padding="6,5" MinHeight="30" FontSize="12" AutomationProperties.Name="Renderer: CPU Reference"
                      ToolTip="Use CPU software reference renderer"/>
            </UniformGrid>
          </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="SceneAssetsTab" Header="Assets" Visibility="Collapsed">
            <DockPanel Margin="15,17,15,14">
              <StackPanel DockPanel.Dock="Top">
                <Button x:Name="NewSprite" Content="Draw sprite…" Click="NewSpriteClicked" Margin="0,0,0,5"/>
                <Button x:Name="CloneSprite" Content="Edit image copy…" Click="CloneSpriteClicked" Margin="0,0,0,5"/>
                <Button x:Name="ImportPng" Content="Import PNG…" Click="ImportPngClicked"/>
                <TextBlock Text="PNG · Up to 256 × 256 pixels" Style="{StaticResource Caption}" Margin="0,7,0,12" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:Name="PlaceAsset" DockPanel.Dock="Bottom" Content="Place selected image" Click="PlaceAssetClicked" Margin="0,10,0,0"/>
              <ListBox x:Name="SceneAssetList" DisplayMemberPath="Label" AutomationProperties.Name="Imported images"
                       Background="{StaticResource Page}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}"
                       SelectionChanged="SceneAssetSelectionChanged" />
            </DockPanel>
          </TabItem>
          <TabItem x:Name="SceneAtlasTab" Header="ATLAS" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="15,17,15,14">
                <TextBlock Text="Local deterministic scene lookup" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SceneAtlasScope" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,5,0,8"/>
                <Button x:Name="SceneAtlasAccess" Click="SceneAtlasAccessClicked" Content="Allow scene read"/>
                <TextBlock Text="Question or proposed change" Style="{StaticResource Caption}" Margin="0,15,0,5"/>
                <TextBox x:Name="SceneAtlasQuestion" AutomationProperties.Name="Scene question" MaxLength="220"
                         Text="Inspect selection" MinHeight="62" TextWrapping="Wrap" Padding="6"
                         ToolTip="Try Inspect selection, Where is Bench light?, or Move Bench light to 0.62, 0.33."
                         Background="{StaticResource Page}" Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource Border}" CaretBrush="{StaticResource Accent}"/>
                <Button x:Name="SceneAtlasAsk" Content="Ask ATLAS" Click="SceneAtlasAskClicked" Margin="0,7,0,10"/>
                <TextBlock x:Name="SceneAtlasResult" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <StackPanel x:Name="SceneAtlasAnswerCard" Visibility="Collapsed" Margin="0,8,0,0">
                  <Button x:Name="SceneAtlasShow" Content="Show object" Click="SceneAtlasShowClicked" Margin="0,0,0,5"/>
                  <Button x:Name="SceneAtlasTarget" Content="Show linked target" Click="SceneAtlasTargetClicked" Margin="0,0,0,5"/>
                  <Button x:Name="SceneAtlasPreview" Content="Preview change" Click="SceneAtlasPreviewClicked" Margin="0,0,0,5"/>
                  <Expander Header="Saved source details">
                    <TextBlock x:Name="SceneAtlasSource" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"/>
                  </Expander>
                </StackPanel>
                <Expander x:Name="SceneAtlasReceipt" Header="Latest saved ATLAS edit" Visibility="Collapsed" Margin="0,14,0,0">
                  <TextBlock x:Name="SceneAtlasReceiptText" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"/>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="MuseumAtlasTab" Header="ATLAS">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="15,17,15,14">
                <TextBlock x:Name="AtlasScopeLabel" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button x:Name="AtlasAccess" Content="Allow project read" Click="AtlasAccessClicked" Margin="0,10,0,18"/>
                <TextBlock Text="Question" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <TextBox x:Name="AtlasQuestion" AutomationProperties.Name="ATLAS question" TextWrapping="Wrap"
                         MinHeight="57" Padding="8" VerticalContentAlignment="Center"
                         Background="{StaticResource Page}" Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource Border}" CaretBrush="{StaticResource Accent}"/>
                <Button x:Name="AtlasAsk" Click="AtlasAskClicked" Style="{StaticResource PrimaryButton}"
                        Margin="0,9,0,0" AutomationProperties.Name="Ask ATLAS">
                  <TextBlock Text="Ask ATLAS" Foreground="#221B16"/>
                </Button>
                <TextBlock x:Name="AtlasReadStatus" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                           Margin="0,10,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                <Border x:Name="AtlasAnswerCard" Visibility="Collapsed" Margin="0,17,0,0" Padding="10"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="6">
                  <StackPanel>
                    <TextBlock x:Name="AtlasAnswerOrigin" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AtlasAnswerText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="AtlasLightState" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    <Button Content="Show in scene" Click="AtlasSourceClicked" Margin="0,10,0,0"
                            AutomationProperties.Name="Show cited lantern in scene"/>
                    <TextBlock x:Name="AtlasProposalText" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource PreviewAccent}" FontSize="12"/>
                    <Button x:Name="AtlasPreviewStart" Content="Preview light change" Click="AtlasPreviewClicked"
                            Margin="0,5,0,0"/>
                    <Button x:Name="AtlasCommitReviewStart" Content="Review save…" Click="AtlasCommitReviewClicked"
                            Margin="0,5,0,0" Visibility="Collapsed"/>
                    <Expander x:Name="AtlasSourceDetails" Header="Source details" Foreground="{StaticResource Text}"
                              Margin="0,9,0,0">
                      <TextBlock x:Name="AtlasSourceText" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                                 Margin="0,7,0,0"/>
                    </Expander>
                  </StackPanel>
                </Border>
                <Expander x:Name="AtlasReceiptCard" Header="Latest saved ATLAS edit" Visibility="Collapsed"
                          Foreground="{StaticResource Text}" Margin="0,17,0,0">
                  <TextBlock x:Name="AtlasReceiptText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <ScrollViewer x:Name="PlayPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Play controls">
          <StackPanel Margin="15,17,15,14">
            <TextBlock Text="Switches" Foreground="{StaticResource PlayAccent}" FontSize="20" FontWeight="SemiBold"/>
            <StackPanel x:Name="ScenePlayControls" Visibility="Collapsed" Margin="0,7,0,0">
              <UniformGrid Columns="4">
                <Button Content="←" Tag="Left" Click="SceneWalkClicked" AutomationProperties.Name="Walk left" Padding="3"/>
                <Button Content="↑" Tag="Up" Click="SceneWalkClicked" AutomationProperties.Name="Walk up" Padding="3"/>
                <Button Content="↓" Tag="Down" Click="SceneWalkClicked" AutomationProperties.Name="Walk down" Padding="3"/>
                <Button Content="→" Tag="Right" Click="SceneWalkClicked" AutomationProperties.Name="Walk right" Padding="3"/>
              </UniformGrid>
              <TextBlock Text="Arrow keys or WASD" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
              <TextBlock x:Name="SceneNearby" TextWrapping="Wrap" Margin="0,9,0,5" AutomationProperties.LiveSetting="Polite"/>
              <Button x:Name="SceneUseSwitch" Click="ScenePlayUseClicked" Content="Use nearby switch (E)" />
            </StackPanel>
            <TextBlock x:Name="PlayEmpty" Text="This scene has no switches." Visibility="Collapsed"
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
            <ItemsControl x:Name="PlaySwitches" Margin="0,10,0,0" AutomationProperties.Name="Runtime switches">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Label}" Tag="{Binding}" Click="PlaySwitchClicked"
                          AutomationProperties.Name="{Binding Label}" BorderBrush="{StaticResource PlayAccent}"
                          Margin="0,0,0,6"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="PlayResultCard" Visibility="Collapsed" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" Background="{StaticResource Surface}" CornerRadius="5" Padding="10"
                    Margin="0,10,0,0">
              <StackPanel>
                <TextBlock x:Name="PlayResultTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="PlayResultText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
            BorderThickness="0,1,0,0" Padding="18,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                   FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock x:Name="BackendText" Grid.Column="1" Margin="12,0,0,0" MaxWidth="250"
                   Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>
  </Grid>
</Window>
