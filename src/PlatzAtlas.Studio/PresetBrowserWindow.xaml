<Window x:Class="PlatzAtlas.Studio.PresetBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLATZ Presets" Width="850" Height="625" MinWidth="690" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Page}" Foreground="{StaticResource Text}">
  <Grid Margin="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="Open preset file…" Click="OpenPresetClicked"/>
      <TextBlock Text="Presets" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,16,0">
      <TextBox x:Name="PresetSearch" DockPanel.Dock="Top" Padding="7,5" TextChanged="FilterChanged"
               AutomationProperties.Name="Search presets" ToolTip="Search by name, category, or use" Margin="0,0,0,8"/>
      <ListBox x:Name="PresetList" Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
               BorderBrush="{StaticResource Border}" AutomationProperties.Name="Preset results"
               SelectionChanged="PresetChanged">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Preset.Title}"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate>
          <StackPanel Orientation="Horizontal" Margin="3,4">
            <Path Width="28" Height="25" Margin="2,0,13,0" Data="{Binding Icon}" Stretch="Uniform"
                  Stroke="{StaticResource Accent}" StrokeThickness="1.7" StrokeLineJoin="Round"/>
            <StackPanel>
              <TextBlock Text="{Binding Preset.Title}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Preset.Category}" Style="{StaticResource Caption}"/>
            </StackPanel>
          </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="PresetEditor">
        <Border Height="100" Background="#15262E" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="5" Margin="0,0,0,11">
          <Path x:Name="PresetIcon" Width="62" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"
                Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeLineJoin="Round"/>
        </Border>
        <TextBlock x:Name="PresetTitle" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="PresetDescription" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,12"/>
        <TextBlock Text="Object name" Style="{StaticResource Caption}"/>
        <TextBox x:Name="PresetName" MaxLength="84" Padding="6,4" Margin="0,4,0,9" AutomationProperties.Name="Preset object name"/>
        <UniformGrid Columns="2" Margin="0,0,0,8">
          <StackPanel Margin="0,0,9,0">
            <TextBlock Text="Width · room units" Style="{StaticResource Caption}"/>
            <TextBox x:Name="PresetWidth" Padding="6,4" Margin="0,4,0,0" AutomationProperties.Name="Preset width"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Height · room units" Style="{StaticResource Caption}"/>
            <TextBox x:Name="PresetHeight" Padding="6,4" Margin="0,4,0,0" AutomationProperties.Name="Preset height"/>
          </StackPanel>
        </UniformGrid>
        <StackPanel x:Name="ChoiceRow" Margin="0,0,0,8">
          <TextBlock x:Name="ChoiceLabel" Style="{StaticResource Caption}"/>
          <ComboBox x:Name="PresetChoice" AutomationProperties.Name="Preset property" Padding="5,3" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel x:Name="GoalRow" Margin="0,0,0,8">
          <TextBlock Text="Keys required to win" Style="{StaticResource Caption}"/>
          <TextBox x:Name="PresetKeys" AutomationProperties.Name="Preset keys required" MaxLength="2" Padding="5,3" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock Text="Instances to place" Style="{StaticResource Caption}"/>
        <TextBox x:Name="PresetCount" AutomationProperties.Name="Instances to place" Text="1" MaxLength="2"
                 Width="64" HorizontalAlignment="Left" Padding="6,4" Margin="0,4,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="SaveVariant" Content="Save variant…" Click="SaveVariantClicked" Margin="0,0,6,0"/>
        <Button x:Name="PlacePreset" Content="Place in room" Style="{StaticResource PrimaryButton}" Click="PlaceClicked" Margin="0,0,6,0"/>
        <Button Content="Close" IsCancel="True"/>
      </StackPanel>
      <TextBlock x:Name="PresetStatus" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
  </Grid>
</Window>
